package com.creativepulse.controller;

import com.creativepulse.dto.InvoiceDto;
import com.creativepulse.dto.PaymentDto;
import com.creativepulse.entity.enums.PaymentMethod;
import com.creativepulse.service.BillingService;
import com.creativepulse.service.CampaignService;
import jakarta.validation.Valid;
import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.validation.BindingResult;
import org.springframework.web.bind.annotation.*;
import org.springframework.web.servlet.mvc.support.RedirectAttributes;

import java.security.Principal;

@Controller
@RequestMapping("/billing")
public class BillingController {

    private final BillingService billingService;
    private final CampaignService campaignService;

    public BillingController(BillingService billingService, CampaignService campaignService) {
        this.billingService = billingService;
        this.campaignService = campaignService;
    }

    @GetMapping("/invoices")
    public String listInvoices(Model model, Principal principal) {
        model.addAttribute("invoices", billingService.getAllInvoices());
        return "billing/invoices";
    }

    @GetMapping("/create-invoice")
    public String showCreateInvoiceForm(Model model) {
        model.addAttribute("invoiceDto", new InvoiceDto());
        model.addAttribute("campaigns", campaignService.getAllCampaigns());
        return "billing/create-invoice";
    }

    @PostMapping("/create-invoice")
    public String createInvoice(@Valid @ModelAttribute("invoiceDto") InvoiceDto dto,
                                BindingResult result,
                                Model model,
                                RedirectAttributes redirectAttributes) {
        if (result.hasErrors()) {
            model.addAttribute("campaigns", campaignService.getAllCampaigns());
            return "billing/create-invoice";
        }
        try {
            billingService.createInvoice(dto);
            redirectAttributes.addFlashAttribute("successMessage", "Invoice created!");
            return "redirect:/billing/invoices";
        } catch (Exception e) {
            model.addAttribute("errorMessage", e.getMessage());
            model.addAttribute("campaigns", campaignService.getAllCampaigns());
            return "billing/create-invoice";
        }
    }

    @GetMapping("/invoices/{id}/pay")
    public String showPaymentForm(@PathVariable Long id, Model model) {
        PaymentDto dto = new PaymentDto();
        dto.setInvoiceId(id);
        
        model.addAttribute("paymentDto", dto);
        model.addAttribute("methods", PaymentMethod.values());
        model.addAttribute("payments", billingService.getPaymentsForInvoice(id));
        return "billing/payment";
    }

    @PostMapping("/invoices/{id}/pay")
    public String recordPayment(@PathVariable Long id,
                                @Valid @ModelAttribute("paymentDto") PaymentDto dto,
                                BindingResult result,
                                Model model,
                                RedirectAttributes redirectAttributes) {
        if (result.hasErrors()) {
            model.addAttribute("methods", PaymentMethod.values());
            model.addAttribute("payments", billingService.getPaymentsForInvoice(id));
            return "billing/payment";
        }
        try {
            dto.setInvoiceId(id);
            billingService.recordPayment(dto);
            redirectAttributes.addFlashAttribute("successMessage", "Payment recorded!");
            return "redirect:/billing/invoices";
        } catch (Exception e) {
            redirectAttributes.addFlashAttribute("errorMessage", e.getMessage());
            return "redirect:/billing/invoices/" + id + "/pay";
        }
    }
}
