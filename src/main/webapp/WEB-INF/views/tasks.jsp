<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html><head><title>Employee Task Management</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body>
<header><h1>CreativePulse Advertising</h1><p>Employee Task Management</p></header><main><div class="head"><div><h2>Employee Tasks</h2><p>Manage employee tasks.</p></div><a class="btn primary" href="${pageContext.request.contextPath}/tasks/new">+ Add Task</a></div>
<form class="search" method="get" action="${pageContext.request.contextPath}/tasks/search"><input name="keyword" value="${keyword}" placeholder="Search task, employee, campaign or status"><button class="btn">Search</button><a class="btn" href="${pageContext.request.contextPath}/tasks">Clear</a></form>
<div class="card"><table><tr><th>ID</th><th>Task</th><th>Employee</th><th>Campaign</th><th>Priority</th><th>Status</th><th>Due</th><th>Actions</th></tr><c:forEach var="t" items="${tasks}"><tr><td>${t.id}</td><td><b>${t.taskName}</b></td><td>${t.assignedTo}</td><td>${t.campaignName}</td><td>${t.priority}</td><td>${t.status}</td><td>${t.dueDate}</td><td><a href="${pageContext.request.contextPath}/tasks/view/${t.id}">View</a> | <a href="${pageContext.request.contextPath}/tasks/edit/${t.id}">Edit</a> | <form class="inline" method="post" action="${pageContext.request.contextPath}/tasks/delete/${t.id}" onsubmit="return confirm('Delete this task?');"><button class="link danger">Delete</button></form></td></tr></c:forEach><c:if test="${empty tasks}"><tr><td colspan="8">No tasks found.</td></tr></c:if></table></div></main></body></html>
