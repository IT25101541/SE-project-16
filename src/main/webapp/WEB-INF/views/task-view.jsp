<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>View Task</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><header><h1>CreativePulse Advertising</h1><p>Employee Task Management</p></header><main class="narrow"><div class="head"><h2>Task Details</h2><a class="btn" href="${pageContext.request.contextPath}/tasks">Back</a></div><div class="card details"><p><b>ID:</b> ${task.id}</p><p><b>Task:</b> ${task.taskName}</p><p><b>Description:</b> ${task.description}</p><p><b>Employee:</b> ${task.assignedTo}</p><p><b>Campaign:</b> ${task.campaignName}</p><p><b>Priority:</b> ${task.priority}</p><p><b>Status:</b> ${task.status}</p><p><b>Due Date:</b> ${task.dueDate}</p></div><br><a class="btn primary" href="${pageContext.request.contextPath}/tasks/edit/${task.id}">Edit Task</a></main></body></html>
