<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Task Form</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><header><h1>CreativePulse Advertising</h1><p>Employee Task Management</p></header><main class="narrow"><div class="head"><h2>${task.id == 0 ? 'Add New Task' : 'Edit Task'}</h2><a class="btn" href="${pageContext.request.contextPath}/tasks">Back</a></div><form class="card" method="post" action="${pageContext.request.contextPath}/tasks/save"><input type="hidden" name="id" value="${task.id}"><label>Task Name *</label><input name="taskName" value="${task.taskName}" required><label>Description</label><textarea name="description" rows="5">${task.description}</textarea><label>Assigned Employee *</label><input name="assignedTo" value="${task.assignedTo}" required><label>Campaign Name</label><input name="campaignName" value="${task.campaignName}"><label>Priority *</label><select name="priority" required><option value="">Select</option><option ${task.priority=='LOW'?'selected':''}>LOW</option><option ${task.priority=='MEDIUM'?'selected':''}>MEDIUM</option><option ${task.priority=='HIGH'?'selected':''}>HIGH</option></select><label>Status *</label><select name="status" required><option value="">Select</option><option ${task.status=='PENDING'?'selected':''}>PENDING</option><option ${task.status=='IN_PROGRESS'?'selected':''}>IN_PROGRESS</option><option ${task.status=='COMPLETED'?'selected':''}>COMPLETED</option></select><label>Due Date *</label><input type="date" name="dueDate" value="${task.dueDate}" required><button class="btn primary" type="submit">Save Task</button></form></main></body></html>
