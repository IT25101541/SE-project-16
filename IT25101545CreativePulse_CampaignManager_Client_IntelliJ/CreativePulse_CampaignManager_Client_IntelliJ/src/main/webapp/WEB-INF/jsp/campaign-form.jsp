<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html><head><title>Campaign Form</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="brand">Creative<span>Pulse</span></div><div class="role">CAMPAIGN MANAGER</div><a href="${pageContext.request.contextPath}/campaign-manager">Overview</a><a class="active" href="${pageContext.request.contextPath}/campaign-manager/campaigns">Campaign Management</a><a href="${pageContext.request.contextPath}/campaign-manager/tasks">Employee Task Management</a><a href="${pageContext.request.contextPath}/clients">Client Management</a></aside>
<main class="content"><header><div><span class="eyebrow">CAMPAIGN MANAGEMENT</span><h1>${campaign.id == null ? 'Create Campaign' : 'Edit Campaign'}</h1></div></header>
<form class="form-card" action="${pageContext.request.contextPath}/campaign-manager/campaigns/save" method="post">
<input type="hidden" name="id" value="${campaign.id}">
<div class="grid"><label>Campaign Name<input name="name" value="${campaign.name}" required></label><label>Client Name<input name="clientName" value="${campaign.clientName}" required></label><label>Start Date<input type="date" name="startDate" value="${campaign.startDate}" required></label><label>End Date<input type="date" name="endDate" value="${campaign.endDate}" required></label><label>Status<select name="status"><option>Planned</option><option>Active</option><option>On Hold</option><option>Completed</option><option>Cancelled</option></select></label><label>Progress %<input type="number" name="progress" min="0" max="100" value="${campaign.progress}"></label><label>Campaign Manager<input name="managerName" value="${campaign.managerName}" required></label><label class="wide">Description<textarea name="description">${campaign.description}</textarea></label></div>
<div class="form-actions"><a class="btn secondary" href="${pageContext.request.contextPath}/campaign-manager/campaigns">Cancel</a><button class="btn" type="submit">Save Campaign</button></div></form></main></div></body></html>
