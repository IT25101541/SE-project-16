<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html><head><title>Client Form</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="brand">Creative<span>Pulse</span></div><div class="role">CLIENT MANAGEMENT</div><a href="${pageContext.request.contextPath}/campaign-manager">Campaign Manager</a><a href="${pageContext.request.contextPath}/campaign-manager/campaigns">Campaign Management</a><a href="${pageContext.request.contextPath}/campaign-manager/tasks">Employee Task Management</a><a class="active" href="${pageContext.request.contextPath}/clients">Client Management</a></aside>
<main class="content"><header><div><span class="eyebrow">CLIENT MANAGEMENT</span><h1>${client.id == null ? 'Create Client' : 'Edit Client'}</h1></div></header>
<form class="form-card" action="${pageContext.request.contextPath}/clients/save" method="post"><input type="hidden" name="id" value="${client.id}">
<div class="grid"><label>Name<input name="name" value="${client.name}" required></label><label>Email<input type="email" name="email" value="${client.email}" required></label><label>Phone<input name="phone" value="${client.phone}"></label><label>Company<input name="company" value="${client.company}"></label><label>Status<select name="status"><option>Active</option><option>Inactive</option></select></label></div>
<div class="form-actions"><a class="btn secondary" href="${pageContext.request.contextPath}/clients">Cancel</a><button class="btn" type="submit">Save Client</button></div></form></main></div></body></html>
