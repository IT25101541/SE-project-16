<%@ page contentType="text/html;charset=UTF-8" %>
<!DOCTYPE html><html><head><title>Task Form</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css"></head>
<body><div class="layout"><aside class="sidebar"><div class="brand">Creative<span>Pulse</span></div><div class="role">CAMPAIGN MANAGER</div><a href="${pageContext.request.contextPath}/campaign-manager">Overview</a><a href="${pageContext.request.contextPath}/campaign-manager/campaigns">Campaign Management</a><a class="active" href="${pageContext.request.contextPath}/campaign-manager/tasks">Employee Task Management</a><a href="${pageContext.request.contextPath}/clients">Client Management</a></aside>
<main class="content"><header><div><span class="eyebrow">EMPLOYEE TASK MANAGEMENT</span><h1>${task.id == null ? 'Create Task' : 'Edit Task'}</h1></div></header>
<form class="form-card" action="${pageContext.request.contextPath}/campaign-manager/tasks/save" method="post"><input type="hidden" name="id" value="${task.id}">
<div class="grid"><label>Campaign ID<input type="number" name="campaignId" value="${task.campaignId}" required></label><label>Task Title<input name="title" value="${task.title}" required></label><label>Employee<input name="employeeName" value="${task.employeeName}" required></label><label>Priority<select name="priority"><option>Low</option><option>Medium</option><option>High</option></select></label><label>Status<select name="status"><option>Pending</option><option>In Progress</option><option>Completed</option><option>Cancelled</option></select></label><label>Deadline<input type="date" name="deadline" value="${task.deadline}" required></label></div>
<div class="form-actions"><a class="btn secondary" href="${pageContext.request.contextPath}/campaign-manager/tasks">Cancel</a><button class="btn" type="submit">Save Task</button></div></form></main></div></body></html>
